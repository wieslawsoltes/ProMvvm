<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="ProMvvm">
      <HintPath>../../src/ProMvvm/bin/$(Configuration)/net10.0/ProMvvm.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <PackageReference Include="ProMvvm.SourceGenerators"
                      Version="$(ProMvvmPackageVersion)"
                      PrivateAssets="all" />
    <Compile Include="../ProMvvm.PackageSmoke/Program.cs" Link="Program.cs" />
  </ItemGroup>
</Project>
