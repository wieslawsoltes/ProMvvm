<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>ProMvvm</AssemblyName>
    <RootNamespace>ProMvvm</RootNamespace>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <IsAotCompatible>true</IsAotCompatible>
    <IsTrimmable>true</IsTrimmable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageId>ProMvvm</PackageId>
    <Version>$(ProMvvmPackageVersion)</Version>
    <Authors>Wiesław Šoltés</Authors>
    <Description>A high-performance, AOT-first MVVM observation library with ReactiveUI WhenAnyValue compatibility.</Description>
    <PackageTags>mvvm;reactive;reactiveui;aot;inotifypropertychanged</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/wieslawsoltes/ProMvvm</RepositoryUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>
  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
    <ProjectReference Include="../ProMvvm.SourceGenerators/ProMvvm.SourceGenerators.csproj"
                      OutputItemType="Analyzer"
                      IncludeAssets="analyzers;build;buildtransitive"
                      PrivateAssets="compile;runtime"
                      GlobalPropertiesToRemove="PublishAot;PublishTrimmed;TrimMode;SelfContained;RuntimeIdentifier" />
  </ItemGroup>
</Project>
